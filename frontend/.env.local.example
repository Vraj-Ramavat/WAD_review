# Neon Postgres Database URL (serverless pooler URL from Neon console)
DATABASE_URL="postgresql://user:password@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secrets for Authentication
JWT_SECRET="super-secret-codegalaxy-access-jwt-key"
JWT_REFRESH_SECRET="super-secret-codegalaxy-refresh-jwt-key"

# GitHub Personal Access Token (PAT) for increased rate limit (5,000 req/hr)
GITHUB_TOKEN="your_github_pat_here"

# Upstash Redis (Optional - for serverless rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
